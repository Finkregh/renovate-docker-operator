{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>mogenius/renovate-config//presets/golang.json#main"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Justfile$/", "/^Dockerfile$/"],
      "matchStrings": ["unpkg\\.com/(?<depName>[^@\"]+)@(?<currentValue>[^/\"]+)"],
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Justfile$/", "/^Dockerfile$/"],
      "matchStrings": ["\"(?<depName>react|react-dom)@(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""],
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "description": "One PR for every Go update: go.mod go directive, golang base image, all Go modules",
      "groupName": "go",
      "groupSlug": "go",
      "matchDatasources": ["gomod", "golang-version"],
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "separateMultipleMajor": false
    },
    {
      "groupName": "go",
      "groupSlug": "go",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/^golang$/"],
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "separateMultipleMajor": false
    },
    {
      "description": "One PR for the JS stack: react, react-dom and @babel/standalone (custom managers above)",
      "groupName": "js",
      "groupSlug": "js",
      "matchDatasources": ["npm"],
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "separateMultipleMajor": false
    },
    {
      "description": "One PR for the remaining container base images (alpine, node, valkey, kubectl, ...)",
      "groupName": "docker",
      "groupSlug": "docker",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["!/^golang$/"],
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "separateMultipleMajor": false
    },
    {
      "description": "One PR for pinned CI action versions and digests",
      "groupName": "ci-actions",
      "groupSlug": "ci-actions",
      "matchManagers": ["github-actions"],
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "separateMultipleMajor": false
    },
    {
      "matchPackageNames": ["registry.k8s.io/kubectl", "valkey"],
      "semanticCommitType": "fix"
    },
    {
      "matchDatasources": ["npm"],
      "semanticCommitType": "fix"
    }
  ]
}
