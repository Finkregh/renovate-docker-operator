# renovate-docker-operator — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# === Required ===
PLATFORM_ENDPOINT=https://git.example.com
RENOVATE_TOKEN=your-forgejo-personal-access-token

# === Platform ===
PLATFORM=forgejo
# RENOVATE_IMAGE=renovate/renovate:latest

# === Scheduling ===
# CRON_SCHEDULE=0 */4 * * *
# GLOBAL_PARALLELISM_LIMIT=2

# === Server ===
# SERVER_PORT=8081
# LOG_LEVEL=info

# === Webhook ===
# WEBHOOK_SERVER_ENABLED=true
# WEBHOOK_SECRET=your-webhook-hmac-secret

# === Auth (OIDC — optional, leave empty for no-auth) ===
# Tip: Use Forgejo itself as OIDC provider!
# Create an OAuth2 app in Forgejo → Site Administration → Applications
# OIDC_ISSUER_URL=https://git.example.com/
# OIDC_CLIENT_ID=renovate-operator
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_REDIRECT_URL=https://renovate.example.com/auth/callback
# SESSION_SECRET=random-32-char-string

# === Discovery Filters (optional) ===
# RENOVATE_DISCOVERY_FILTERS=org1/*,org2/repo-*
# AUTODISCOVER_SKIP_FORKS=false
