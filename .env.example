# renovate-docker-operator — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Prefix convention:
#   ROP_*      — consumed by the Go operator only
#   RENOVATE_* — passed through 1:1 to spawned Renovate containers

# === Required ===
ROP_PLATFORM_ENDPOINT=https://git.example.com
RENOVATE_TOKEN=your-forgejo-personal-access-token

# === Platform ===
# RENOVATE_PLATFORM=forgejo
# ROP_IMAGE=renovate/renovate:latest

# === Image freshness / update check ===
# ROP_IMAGE_CACHE_TTL caches the pulled image AND drives the background
# re-pull interval. Default 24h. 0 disables both caching and background refresh.
# ROP_IMAGE_CACHE_TTL=24h
#
# ROP_CHECK_UPDATE_RUNNER_IMAGE enables the registry update-check poller
# (the UI ⚠ badge + /api/v1/image-status). Default true; set false to disable.
# ROP_CHECK_UPDATE_RUNNER_IMAGE=true
#
# ROP_IMAGE_UPDATE_POLL_INTERVAL is how often the poller checks the registry.
# Defaults to the value of ROP_IMAGE_CACHE_TTL. A positive value below the
# 15m (900s) floor is rejected at startup; 0 = run a single check at startup
# with no recurring poll.
# ROP_IMAGE_UPDATE_POLL_INTERVAL=24h
#
# Non-enforced interactions to be aware of:
#   - ROP_IMAGE_CACHE_TTL=0 with the poller enabled: the poller still runs on
#     its own interval, but no background image refresh happens — an available
#     update is reported, never pulled automatically.
#   - A digest-pinned ROP_IMAGE (e.g. ...@sha256:...) never reports an update:
#     the configured ref is already fully specified.

# === Scheduling ===
# ROP_CRON_SCHEDULE=0 */4 * * *
# ROP_PARALLELISM=2

# === Volumes ===
# ROP_CACHE_VOLUME=renovate-cache
# ROP_CONTAINERBASE_CACHE_VOLUME=renovate-containerbase-cache

# === Server ===
# ROP_SERVER_PORT=8081
# ROP_LOG_LEVEL=info

# === Container Log Level (override Renovate container log level) ===
# RENOVATE_LOG_LEVEL=debug

# === Webhook ===
# ROP_WEBHOOK_ENABLED=true
# ROP_WEBHOOK_SECRET is optional — a random secret is auto-generated on first startup.
# Set this only if you need a specific value (e.g., infrastructure-as-code).
# ROP_WEBHOOK_SECRET=your-webhook-hmac-secret

# === Auth (OIDC — optional, leave empty for no-auth) ===
# Tip: Use Forgejo itself as OIDC provider!
# Create an OAuth2 app in Forgejo → Site Administration → Applications
# ROP_OIDC_ISSUER_URL=https://git.example.com/
# ROP_OIDC_CLIENT_ID=renovate-operator
# ROP_OIDC_CLIENT_SECRET=your-client-secret
# ROP_OIDC_REDIRECT_URL=https://renovate.example.com/auth/callback
# ROP_SESSION_SECRET=random-32-char-string

# === Discovery Filters (optional) ===
# ROP_DISCOVERY_FILTERS=org1/*,org2/repo-*
# ROP_SKIP_FORKS=false
